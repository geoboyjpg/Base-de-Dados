  <Placemark id="sitios_arqueologicos.18">
	<ExtendedData><SchemaData schemaUrl="#sitios_arqueologicos">
		<SimpleData name="fid">18</SimpleData>
		<SimpleData name="codigo">PHA-029</SimpleData>
		<SimpleData name="Código IPHAN">SC4207304BAST00015</SimpleData>
		<SimpleData name="Identificação">Costão da Praia dos Amores</SimpleData>
		<SimpleData name="no_logradouro">Sem informação</SimpleData>
		<SimpleData name="Síntese">Sambaqui localizado no costão sul da Praia dos Amores, localizado(a) no estado de Santa Catarina, cidade(s) de Imbituba, é um Bem Arqueológico, do tipo Sítio. São dois os sambaquis nessa praia: um no costão norte e outro no costão sul. Portanto, este registro trata-se do sambaqui no costão sul, o maior entre os dois, ocupando toda a planície do promontório. Acima do mesmo, encontra-se casa de vigia da comunidade pescadora local. Registro feito por Isabela Müller, a partir de denúncia/vistoria no processo 01510.000223/2022-01.</SimpleData>
		<SimpleData name="Data do cadastro">2023/03/02</SimpleData>
		<SimpleData name="Município">Imbituba</SimpleData>
		<SimpleData name="Localização na APABF">Interno</SimpleData>
		<SimpleData name="numero">29</SimpleData>
		<SimpleData name="Longitude">-48.6577</SimpleData>
		<SimpleData name="Latitude">-28.19278</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>-48.657704,-28.1927795</coordinates></Point>
  </Placemark>
  <Placemark id="sitios_arqueologicos.19">
	<ExtendedData><SchemaData schemaUrl="#sitios_arqueologicos">
		<SimpleData name="fid">19</SimpleData>
		<SimpleData name="codigo">PHA-030</SimpleData>
		<SimpleData name="Código IPHAN">SC4207304BAST00014</SimpleData>
		<SimpleData name="Identificação">Sambaqui da Praia dos Amores</SimpleData>
		<SimpleData name="no_logradouro">Sem informação</SimpleData>
		<SimpleData name="Síntese">Sambaqui localizado no costão norte da Praia dos Amores, localizado(a) no estado de Santa Catarina, cidade(s) de Imbituba, é um Bem Arqueológico, do tipo Sítio. A praia dos Amores possui dois sítios, um no costão norte e outro no costão sul, e este trata-se do sítio no costão norte. Muito impactado e possivelmente será completamente destruído pela ação das marés especialmente. Encontra-se embaixo de casa/rancho de pescador e a trilha da praia da Ribanceira à Praia dos Amores passa por cima do mesmo.</SimpleData>
		<SimpleData name="Data do cadastro">2023/03/02</SimpleData>
		<SimpleData name="Município">Imbituba</SimpleData>
		<SimpleData name="Localização na APABF">Interno</SimpleData>
		<SimpleData name="numero">30</SimpleData>
		<SimpleData name="Longitude">-48.65922</SimpleData>
		<SimpleData name="Latitude">-28.19313</SimpleData>
	</SchemaData></ExtendedData>
      <Point><coordinates>-48.659224,-28.1931303</coordinates></Point>
  </Placemark>
